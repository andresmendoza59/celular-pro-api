# ─── Servidor ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Base de datos PostgreSQL ─────────────────────────────────
# Supabase:  postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Neon:      postgresql://[USER]:[PASSWORD]@[HOST]/[DB]?sslmode=require
# Railway:   postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB]
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/celularpro"

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_clave_aleatoria_segura
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
